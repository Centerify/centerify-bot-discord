    "execute": [
      {
        "description": "create table \"custom_command\"",
        "sql": "CREATE TABLE \"public\".\"custom_command\" (\n  \"content\" jsonb NOT NULL,\n  \"cooldownScope\" text DEFAULT 'USER' NOT NULL,\n  \"cooldownSeconds\" int4 DEFAULT 0 NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdBy\" text NOT NULL,\n  \"deleteInvocation\" bool DEFAULT false NOT NULL,\n  \"description\" text DEFAULT '' NOT NULL,\n  \"enabled\" bool DEFAULT true NOT NULL,\n  \"guildId\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"lastUsedAt\" timestamptz,\n  \"name\" text NOT NULL,\n  \"replyToInvocation\" bool DEFAULT true NOT NULL,\n  \"responseType\" text DEFAULT 'TEXT' NOT NULL,\n  \"triggerType\" text DEFAULT 'BOTH' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"updatedBy\" text NOT NULL,\n  \"usageCount\" int4 DEFAULT 0 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"custom_command_cooldown_6f7f823d\" CHECK (\"cooldownSeconds\" >= 0 AND \"cooldownSeconds\" <= 86400),\n  CONSTRAINT \"custom_command_normalized_name_3dad82ba\" CHECK (name = lower(btrim(name))),\n  CONSTRAINT \"custom_command_response_b4a3f921\" CHECK (\"responseType\" IN ('TEXT', 'EMBED', 'MULTI')),\n  CONSTRAINT \"custom_command_scope_3827e66b\" CHECK (\"cooldownScope\" IN ('USER', 'CHANNEL', 'GUILD', 'GLOBAL_COMMAND')),\n  CONSTRAINT \"custom_command_trigger_f7eca854\" CHECK (\"triggerType\" IN ('SLASH', 'MESSAGE', 'BOTH'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"custom_command\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"custom_command\""
        ]
      }
    ]
