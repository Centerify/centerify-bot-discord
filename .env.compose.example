# Copy to .env.compose and use: docker compose --env-file .env.compose ...
# Keep this file private on the host. Never commit real credentials.
DISCORD_TOKEN=

# Generate TWO different passwords with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use hexadecimal passwords so the application's database URL needs no escaping.
POSTGRES_PASSWORD=
CENTERIFY_DB_PASSWORD=

# Use a release tag or Git commit when building an upgrade.
CENTERIFY_IMAGE_TAG=local
LOG_LEVEL=info

# Optional compose.dashboard.yaml. Never reuse the database passwords here.
AUTH_URL=https://dashboard.example.com
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
CENTERIFY_DASHBOARD_BRIDGE_SECRET=
CENTERIFY_DASHBOARD_OPERATORS=
