# The root dashboard launcher also accepts --config and --env-file.
# For npm --prefix dashboard run dev, copy to dashboard/.env.local.
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
CENTERIFY_DASHBOARD_BRIDGE_URL=http://127.0.0.1:3010
CENTERIFY_DASHBOARD_BRIDGE_SECRET=replace-with-a-different-random-secret
# Explicit demo mode has sample data and performs no Discord effects.
CENTERIFY_DASHBOARD_DEMO=false
