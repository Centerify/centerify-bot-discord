{
  "schemaVersion": 1,
  "plugins": [
    {
      "manifest": {
        "id": "better-ticket",
        "name": "Better Ticket",
        "version": "1.1.0",
        "description": "Support departments, intake forms, ticket claims, priorities, private notes, transcripts, reopen, ratings, saved replies, limits and inactivity closing.",
        "apiVersion": 1,
        "entrypoint": "index.js",
        "permissions": [
          "dashboard.tickets",
          "ManageChannels",
          "ManageRoles",
          "ViewChannel",
          "SendMessages",
          "ReadMessageHistory",
          "AttachFiles",
          "EmbedLinks",
          "AddReactions",
          "CreatePublicThreads",
          "CreatePrivateThreads",
          "SendMessagesInThreads"
        ],
        "dependencies": ["guilds"]
      },
      "packagePath": "plugins/better-ticket/package",
      "sha256": "7a6af9d0c1ff73062ac857fa591ae9ef0625d5a64f0df5aba77d2380b3a4b7cc"
    },
    {
      "manifest": {
        "id": "community-kit",
        "name": "Community Kit",
        "version": "1.0.0",
        "description": "Optional example dashboard widget, route, theme and greeting workflow node. Install globally, then explicitly activate per guild.",
        "apiVersion": 1,
        "entrypoint": "index.js",
        "permissions": [
          "dashboard.widget",
          "dashboard.route",
          "dashboard.theme",
          "builder.node",
          "bot.respond"
        ],
        "dependencies": ["guilds"]
      },
      "packagePath": "plugins/community-kit/package",
      "sha256": "596250a63bb7c942d1c9786dec87a6effe4018310dea76073e0f2ef64fc94006"
    }
  ]
}
