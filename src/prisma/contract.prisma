// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model TestRecord {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt TimestamptzString @default(now())

  @@map("test_record")
}

model GuildConfig {
  id               Int      @id @default(autoincrement())
  guildId          String   @unique
  xpEnabled        Boolean @default(false)
  xpMethods        String @default("messages")
  xpMessageAmount  Int @default(15)
  xpReactionAmount Int @default(5)
  xpDailyAmount    Int @default(100)
  xpCooldownSeconds Int @default(60)
  xpSharing        String @default("server")
  xpSharedGuildIds String @default("")
  setupCompleted   Boolean  @default(false)
  welcomeEnabled   Boolean  @default(false)
  welcomeChannelId String?
  welcomeMessage   String   @default("Welcome {user} to **{server}**! You are member #{memberCount}.")
  goodbyeEnabled   Boolean  @default(false)
  goodbyeChannelId String?
  goodbyeMessage   String   @default("{displayName} left **{server}**. We now have {memberCount} members.")
  autoRoleEnabled  Boolean  @default(false)
  autoRoleId       String?
  loggingEnabled   Boolean  @default(false)
  loggingChannelId String?
  globalBanEnabled  Boolean @default(false)
  globalWarnEnabled Boolean @default(false)
  globalNoteEnabled Boolean @default(false)
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@map("guild_config")
}

model CustomResponse {
  id              Int      @id @default(autoincrement())
  guildId         String
  name            String
  kind            String
  trigger         String
  response        String
  channelId       String?
  allowedRoleId   String?
  adminOnly       Boolean  @default(false)
  exactMatch      Boolean  @default(true)
  embed           Boolean  @default(false)
  cooldownSeconds Int      @default(0)
  enabled         Boolean  @default(true)
  createdBy       String
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([guildId, name])
  @@index([guildId, kind, enabled])
  @@map("custom_response")
}

model GuildOwnership {
  id          Int      @id @default(autoincrement())
  guildId     String   @unique
  ownerUserId String
  verifiedAt  TimestamptzString @default(now())
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([ownerUserId])
  @@map("guild_ownership")
}

model GuildOwnershipRequest {
  id               Int      @id @default(autoincrement())
  guildId          String   @unique
  ownerUserId      String
  tokenDigest      String   @unique
  expiresAt        TimestamptzString
  acceptedAt       TimestamptzString?
  acceptedByUserId String?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([expiresAt])
  @@index([ownerUserId])
  @@map("guild_ownership_request")
}

enum ModerationAction {
  @@type("pg/text@1")
  WARNING = "WARNING"
  TIMEOUT = "TIMEOUT"
  KICK    = "KICK"
  BAN     = "BAN"
  UNBAN   = "UNBAN"
  NOTE    = "NOTE"
}

enum ReportStatus {
  @@type("pg/text@1")
  PENDING  = "PENDING"
  ACCEPTED = "ACCEPTED"
  REJECTED = "REJECTED"
}

model ModerationCaseCounter {
  id             Int      @id @default(autoincrement())
  guildId        String   @unique
  nextCaseNumber Int      @default(1)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@map("moderation_case_counter")
}

model ModerationCase {
  id              Int      @id @default(autoincrement())
  guildId         String
  caseNumber      Int
  targetUserId    String
  moderatorUserId String
  action          ModerationAction
  reason          String
  durationMs      Int?
  isGlobal        Boolean  @default(false)
  metadata        Jsonb?
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  @@unique([guildId, caseNumber])
  @@index([guildId, targetUserId])
  @@index([guildId, moderatorUserId])
  @@index([guildId, action])
  @@index([guildId, createdAt])
  @@index([targetUserId, isGlobal, action])
  @@map("moderation_case")
}

model ReportCounter {
  id               Int      @id @default(autoincrement())
  guildId          String   @unique
  nextReportNumber Int      @default(1)
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@map("report_counter")
}

model MemberReport {
  id             Int      @id @default(autoincrement())
  guildId        String
  reportNumber   Int
  reportedUserId String
  reporterUserId String
  reason         String
  status         ReportStatus @default(PENDING)
  reviewedBy     String?
  reviewedAt     TimestamptzString?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([guildId, reportNumber])
  @@index([guildId, reportedUserId])
  @@index([guildId, reporterUserId])
  @@index([guildId, status])
  @@index([guildId, createdAt])
  @@map("member_report")
}

model MemberXp {
  id            Int @id @default(autoincrement())
  guildId       String
  userId        String
  xp            Int @default(0)
  lastReactionAwardedAt TimestamptzString?
  lastDailyAwardedAt TimestamptzString?
  lastAwardedAt TimestamptzString

  @@unique([guildId, userId])
  @@index([userId])
  @@map("member_xp")
}


// A guild-local namespace shared by canonical names and aliases.
model CustomCommand {
  id Int @id @default(autoincrement())
  guildId String
  name String
  description String @default("")
  enabled Boolean @default(true)
  triggerType String @default("BOTH")
  responseType String @default("TEXT")
  content Jsonb
  cooldownSeconds Int @default(0)
  cooldownScope String @default("USER")
  deleteInvocation Boolean @default(false)
  replyToInvocation Boolean @default(true)
  usageCount Int @default(0)
  lastUsedAt TimestamptzString?
  createdBy String
  updatedBy String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  names CustomCommandName[]
  restrictions CustomCommandRestriction[]

  @@unique([guildId, id])
  @@unique([guildId, name])
  @@index([guildId, enabled, triggerType])
  @@index([enabled])
  @@index([triggerType])
  @@check(expression: "name = lower(btrim(name))", name: "custom_command_normalized_name")
  @@check(expression: "\"cooldownSeconds\" >= 0 AND \"cooldownSeconds\" <= 86400", name: "custom_command_cooldown")
  @@check(expression: "\"triggerType\" IN ('SLASH', 'MESSAGE', 'BOTH')", name: "custom_command_trigger")
  @@check(expression: "\"responseType\" IN ('TEXT', 'EMBED', 'MULTI')", name: "custom_command_response")
  @@check(expression: "\"cooldownScope\" IN ('USER', 'CHANNEL', 'GUILD', 'GLOBAL_COMMAND')", name: "custom_command_scope")
  @@map("custom_command")
}

model CustomCommandName {
  id Int @id @default(autoincrement())
  guildId String
  commandId Int
  name String
  command CustomCommand @relation(fields: [guildId, commandId], references: [guildId, id])

  @@unique([guildId, name])
  @@index([guildId, commandId])
  @@check(expression: "name = lower(btrim(name))", name: "custom_command_name_normalized")
  @@map("custom_command_name")
}

model CustomCommandRestriction {
  id Int @id @default(autoincrement())
  guildId String
  commandId Int
  kind String
  value String
  command CustomCommand @relation(fields: [guildId, commandId], references: [guildId, id])

  @@unique([guildId, commandId, kind, value])
  @@check(expression: "kind IN ('allowedRoleIds', 'deniedRoleIds', 'allowedChannelIds', 'deniedChannelIds', 'requiredUserPermissions', 'requiredBotPermissions')", name: "custom_command_restriction_kind")
  @@map("custom_command_restriction")
}

model CustomCommandSharing {
  commandId Int @id
  guildId String
  actorId String
  scope String
  selectedGuildIds String @default("")
  command CustomCommand @relation(fields: [guildId, commandId], references: [guildId, id], onDelete: Cascade)

  @@check(expression: "scope IN ('all', 'selected')", name: "custom_command_sharing_scope")
  @@index([guildId])
  @@map("custom_command_sharing")
}
