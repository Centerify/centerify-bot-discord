# Copy this file to .env. Never commit real credentials.
DISCORD_TOKEN=
DATABASE_URL=postgresql://centerify:change-me@localhost:5432/centerify
# PostgreSQL 15 or newer is required.

# Optional paths, relative to the working directory. Bot customization lives in JSON.
# CENTERIFY_CONFIG=centerify.config.json
# CENTERIFY_ENV_FILE=.env.production

# JSON logs are suitable for production log collectors.
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
# SHUTDOWN_TIMEOUT_MS=10000

# Unspecified modules stay enabled. Restart after changing module selection.
# CENTERIFY_MODULES={}
# Example: disable XP; retain the remaining features.
# CENTERIFY_MODULES={"xp":false}
# Custom-command limits are owned by that module.
# CENTERIFY_MODULES={"custom-commands":{"config":{"maxCommands":200,"maxLegacyResponses":40}}}
