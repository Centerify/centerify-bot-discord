# Copy this file to .env. Never commit real credentials.
DISCORD_TOKEN=
DATABASE_URL=postgresql://centerify:change-me@localhost:5432/centerify
# PostgreSQL 15 or newer is required.

# Optional paths, relative to the working directory. Bot customization lives in JSON.
# CENTERIFY_CONFIG=centerify.config.json
# CENTERIFY_ENV_FILE=.env.production

# JSON logs are suitable for production log collectors.
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
# SHUTDOWN_TIMEOUT_MS=10000
# Optional loopback readiness listener. Compose enables port 3000 automatically.
# CENTERIFY_HEALTH_PORT=3000
# CENTERIFY_PLUGIN_STATE_DIR=.centerify
# Optional dashboard bridge; leave unset to keep the dashboard module disabled.
# CENTERIFY_DASHBOARD_BRIDGE_SECRET=use-a-random-secret-at-least-32-characters
# CENTERIFY_DASHBOARD_BRIDGE_HOST=127.0.0.1
# CENTERIFY_DASHBOARD_BRIDGE_PORT=3010
# CENTERIFY_DASHBOARD_OPERATORS=comma-separated-discord-user-ids
# AUTH_URL=https://dashboard.example.com
# AUTH_SECRET=use-a-different-random-session-secret
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=
# CENTERIFY_DASHBOARD_BRIDGE_URL=http://127.0.0.1:3010
# CENTERIFY_DASHBOARD_DEMO=false

# Unspecified modules stay enabled. Restart after changing module selection.
# CENTERIFY_MODULES={}
# Example: disable XP; retain the remaining features.
# CENTERIFY_MODULES={"xp":false}
# Custom-command limits are owned by that module.
# CENTERIFY_MODULES={"custom-commands":{"config":{"maxCommands":200,"maxLegacyResponses":40}}}
